#!/bin/sh
# Set up the jobkit commands for the jobkit plugin (macOS and Linux).
#   sh setup/install --check     print one line: ok:<folder> | newer:<folder> | older:<folder> | older+python:<folder>
#                                | missing | missing+python | old-uv | no-uv | unsupported
#                                (+python: the Python version the commands need is not on the computer yet, so an
#                                install downloads it too; old-uv: uv is older than the minimum and is never replaced)
#   sh setup/install             install the commands from this plugin with the uv already on the computer
#   sh setup/install --with-uv   the same, and first download uv if it is missing
# Run it only after the user has said yes: uv downloads Python and packages. --with-uv also downloads uv
# (from astral.sh); pass it only when the user asked for uv to be installed for them.
# It never replaces a uv that is already there and never installs over newer commands.
set -eu

# The uv release downloaded when uv is missing. Keep it equal to the one in setup/install.ps1.
UV_VERSION=0.13.7

ROOT=$(cd "$(dirname "$0")/.." && pwd)

case "$(uname -s)" in
    Darwin | Linux) ;;
    *) echo "unsupported"; exit 2 ;;
esac

# The package version, the oldest uv accepted, and the Python version: all read from the plugin's own files.
wanted=$(sed -n 's/^version *= *"\([^"]*\)".*/\1/p' "$ROOT/pyproject.toml" | head -n 1)
uv_minimum=$(sed -n 's/^required-version *= *">=\([^"]*\)".*/\1/p' "$ROOT/pyproject.toml" | head -n 1)
python_version=$(head -n 1 "$ROOT/.python-version" | tr -d ' \r')

# Print lt, eq or gt for two dotted versions, compared number by number (0.10.0 is above 0.9.0).
compare() {
    left=$1 right=$2
    while [ -n "$left" ] || [ -n "$right" ]; do
        a=$(printf '%s' "${left%%.*}" | sed 's/[^0-9].*//')
        b=$(printf '%s' "${right%%.*}" | sed 's/[^0-9].*//')
        case "$left" in *.*) left=${left#*.} ;; *) left= ;; esac
        case "$right" in *.*) right=${right#*.} ;; *) right= ;; esac
        if [ "${a:-0}" -lt "${b:-0}" ]; then echo lt; return 0; fi
        if [ "${a:-0}" -gt "${b:-0}" ]; then echo gt; return 0; fi
    done
    echo eq
}

find_uv() {
    if command -v uv >/dev/null 2>&1; then command -v uv; return 0; fi
    for candidate in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv"; do
        if [ -x "$candidate" ]; then echo "$candidate"; return 0; fi
    done
    return 1
}

# The folder that holds the jobkit commands, or nothing.
tool_folder() {
    uv_path=$(find_uv) || return 1
    folder=$("$uv_path" tool dir --bin 2>/dev/null) || return 1
    [ -x "$folder/jobkit" ] || return 1
    echo "$folder"
}

installed_version() {
    "$1/jobkit" --version 2>/dev/null | sed 's/^jobkit //'
}

uv_version() {
    "$1" --version 2>/dev/null | sed -n 's/^uv \([0-9][0-9.]*\).*/\1/p' | head -n 1
}

# "+python" when the Python version the commands need is not installed yet (uv would download it), else nothing.
python_need() {
    if "$1" python find --system --no-project "$python_version" >/dev/null 2>&1; then echo ""; else echo "+python"; fi
}

check() {
    folder=
    state=missing
    if folder=$(tool_folder); then
        case "$(compare "$(installed_version "$folder")" "$wanted")" in
            eq) echo "ok:$folder"; return 0 ;;
            gt) echo "newer:$folder"; return 0 ;;
            *) state=older ;;
        esac
    fi
    if ! uv_path=$(find_uv); then
        echo "no-uv"
        return 0
    fi
    have=$(uv_version "$uv_path")
    if [ "$(compare "${have:-0}" "$uv_minimum")" = lt ]; then
        echo "old-uv"
        return 0
    fi
    echo "$state$(python_need "$uv_path")${folder:+:$folder}"
}

if [ "${1:-}" = "--check" ]; then
    check
    exit 0
fi

current=$(check)
case "$current" in
    ok:* | newer:*) echo "$current"; exit 0 ;;
esac

if uv_path=$(find_uv); then
    have=$(uv_version "$uv_path")
    if [ "$(compare "${have:-0}" "$uv_minimum")" = lt ]; then
        echo "failed: uv is too old (found ${have:-an unknown version}, need $uv_minimum or newer); it was left as it is" >&2
        exit 3
    fi
elif [ "${1:-}" != "--with-uv" ]; then
    echo "failed: uv is not installed" >&2
    exit 4
else
    if ! command -v curl >/dev/null 2>&1; then
        echo "failed: curl is not available, so uv could not be downloaded" >&2
        exit 1
    fi
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    if ! curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" -o "$scratch/uv-install.sh"; then
        echo "failed: uv could not be downloaded" >&2
        exit 1
    fi
    if ! UV_NO_MODIFY_PATH=1 sh "$scratch/uv-install.sh" >/dev/null 2>&1; then
        echo "failed: uv could not be installed" >&2
        exit 1
    fi
fi

uv_path=$(find_uv) || { echo "failed: uv was not found after installing it" >&2; exit 1; }
if ! "$uv_path" tool install --force --python "$python_version" \
        --constraints "$ROOT/setup/constraints.txt" "$ROOT" >/dev/null 2>&1; then
    echo "failed: the jobkit commands could not be installed" >&2
    exit 1
fi

result=$(check)
case "$result" in
    ok:*) echo "$result" ;;
    *) echo "failed: the installed commands do not match the plugin ($result)" >&2; exit 1 ;;
esac
