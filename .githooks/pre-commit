#!/bin/sh
# Runs the project checks before each commit. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "Running pre-commit hooks ..."
PY=.venv/bin/python
[ -x "$PY" ] || PY=.venv/Scripts/python.exe     # Windows (Git for Windows runs this hook)
if [ ! -x "$PY" ]; then
    echo "pre-commit: .venv not found. Create it with: uv sync" >&2
    exit 1
fi
run() {
    echo "pre-commit: $1"
    shift
    "$@" || { echo "pre-commit: FAILED, commit aborted" >&2; exit 1; }
}
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found (secret scan). Install it: brew install gitleaks" >&2
    exit 1
fi
run "gitleaks" gitleaks git --pre-commit --staged --redact --no-banner
# Your own personal terms (name, employers, products...) and text from your stored data (resume lines, stories,
# figures, titles) must not be in what is staged; skipped without a database.
run "personal terms and phrases" "$PY" -m jk.user.profile terms check --staged
run "ruff"  "$PY" -m ruff check plugins/jobkit/src tests tools
run "pyright" "$PY" -m pyright --project pyrightconfig.json
run "tests" "$PY" -m unittest discover -s tests -t .
# Staged specs must pass strict OpenSpec validation (a requirement is one short behavior; detail goes in scenarios).
if command -v openspec >/dev/null 2>&1; then
    for f in $(git diff --cached --name-only --diff-filter=ACM -- 'openspec/specs/*/spec.md' 'openspec/specs/*/*/spec.md'); do
        cap=${f#openspec/specs/}; cap=${cap%/spec.md}
        run "openspec validate $cap" openspec validate "$cap" --type spec --strict
    done
else
    echo "pre-commit: openspec not found, spec check skipped" >&2
fi
