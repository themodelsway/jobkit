[MAIN]
ignore=fixtures

[MESSAGES CONTROL]
disable=missing-module-docstring,too-few-public-methods,invalid-name,line-too-long,duplicate-code

[VARIABLES]
# Command handlers all take the parsed args, used or not.
ignored-argument-names=args|_.*

[DESIGN]
max-attributes=10
max-args=7
max-positional-arguments=7
max-locals=18
